generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Item {
  id        String   @id @default(uuid())
  sku       String?   @unique
  name      String
  category  String
  stock     Int      @default(0)
  minStock  Int      @default(5)
  price     Float    @default(0.0)
  location  String?
  supplier  String?
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id             String   @id
  name           String
  type           String
  supplierFilter String
  format         String
  createdDate    String
  rawItems       Json     // Speichert die Artikel-Daten als JSON in PostgreSQL
  createdAt      DateTime @default(now())
}